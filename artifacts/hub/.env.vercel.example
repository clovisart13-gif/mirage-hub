# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente para deploy paralelo no Vercel
# Copie este arquivo como referência ao configurar o projeto
# no painel do Vercel (Settings → Environment Variables)
# ─────────────────────────────────────────────────────────────

# URL completa do backend (API Server)
# Em produção atual (Replit): use a URL do domínio publicado
# Ex: https://gestaomirage.com.br  ou  https://api.gestaomirage.com.br
# Deixar vazio não funciona no Vercel — o frontend chamaria /api no mesmo host
VITE_API_URL=https://SEU_BACKEND_URL_AQUI

# ID do container do Google Tag Manager
# Será ativado assim que Marcus confirmar o domínio apontado
VITE_GTM_ID=GTM-MXF7FNQ9

# NODE_ENV deve ser production no Vercel
NODE_ENV=production
